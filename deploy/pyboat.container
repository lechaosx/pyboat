[Unit]
Description=Pyboat game server
ConditionPathExists=%h/.local/share/pyboat/certificates/live/pyboat/fullchain.pem

[Container]
Image=localhost/pyboat:deployed
Pull=never
ContainerName=pyboat
Network=host
Volume=%h/.local/share/pyboat/certificates:/certificates:ro
Exec=0.0.0.0:8443 /certificates/live/pyboat/fullchain.pem /certificates/live/pyboat/privkey.pem
ReadOnly=true
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=no
ExecReload=/run/current-system/sw/bin/podman kill --signal HUP pyboat

[Install]
WantedBy=default.target
