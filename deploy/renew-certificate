#!/usr/bin/env bash
set -euo pipefail

state="$HOME/.local/share/pyboat/certificates"
certificate="$state/live/pyboat/fullchain.pem"
mkdir -p "$state"
before=$(sha256sum "$certificate" 2>/dev/null || true)
identifier=(--domain "${WEBTRANSPORT_HOST:?}")
if [[ "$WEBTRANSPORT_HOST" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  identifier=(--ip-address "$WEBTRANSPORT_HOST")
fi

podman run --rm --network host \
  --volume "$state:/etc/letsencrypt" \
  docker.io/certbot/certbot@sha256:bc93cb710b413e6b456d622f9b0133b3e109c0a78c2ed9976af43d209b0a1805 \
  certonly --standalone --http-01-port 8080 --non-interactive --agree-tos \
  --register-unsafely-without-email --preferred-profile shortlived \
  --cert-name pyboat --keep-until-expiring "${identifier[@]}"

if [[ "$(sha256sum "$certificate")" != "$before" ]]; then
  systemctl --user --no-block try-reload pyboat.service
fi
