{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm --prefix .. run build:wasm",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "postbuild": "cargo about generate --frozen -m ../crates/browser/Cargo.toml ../crates/browser/about.hbs -o dist/third-party-licenses-rust.md",
    "preview": "vite preview"
  },
  "dependencies": {
    "browser": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-wasm": "^3.6.0"
  }
}
